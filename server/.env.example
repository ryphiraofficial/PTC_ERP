# Render Environment Variables
# Set these in Render Dashboard -> Web Service -> Environment

PORT=5000
NODE_ENV=production

# MongoDB Atlas connection string (or Render MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/ledgerly_gst?retryWrites=true&w=majority

# Secret key for JWT session verification
JWT_SECRET=ledgerly_super_secure_production_jwt_secret_2026

# URL of your hosted Vercel frontend (for CORS security)
# Example: https://ledgerly-frontend.vercel.app
CLIENT_URL=https://*.vercel.app,http://localhost:3000
